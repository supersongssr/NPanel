{
    "log": {
        "loglevel": "info",
        "access": "/var/log/xray/access.log"
    },
    "inbounds": [
        {
            "port": "__visionPort__",
            "protocol": "vless",
            "settings": {
                "decryption": "none",
                "fallbacks": [
                    {
                        "dest": "127.0.0.1:8088"
                    },
                    {
                        "alpn": "h2",
                        "dest": "127.0.0.1:8088"
                    }
                ]
            },
            "streamSettings": {
                "network": "tcp",
                "security": "tls",
                "tlsSettings": {
                    "rejectUnknownSni": true,
                    "minVersion": "1.2",
                    "certificates": [
                        {
                            "ocspStapling": 3600,
                            "certificateFile": "/etc/ssl/__nodeDomain__.pem",
                            "keyFile": "/etc/ssl/__nodeDomain__.key"
                        }
                    ]
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls"
                ]
            },
            "tag": "proxy-vision"
        },
        {
            "port": "__hy2Port__",
            "protocol": "hysteria",
            "settings": {
                "version": 2
            },
            "streamSettings": {
                "network": "hysteria",
                "security": "tls",
                "tlsSettings": {
                    "rejectUnknownSni": true,
                    "minVersion": "1.3",
                    "maxVersion": "1.3",
                    "alpn": [
                        "h3"
                    ],
                    "certificates": [
                        {
                            "ocspStapling": 3600,
                            "certificateFile": "/etc/ssl/__nodeDomain__.pem",
                            "keyFile": "/etc/ssl/__nodeDomain__.key"
                        }
                    ]
                },
                "hysteriaSettings": {
                    "version": 2,
                    "udpIdleTimeout": 60,
                    "masquerade": {
                        "type": "proxy",
                        "url": "__HYSTERIA_URL__",
                        "rewriteHost": true
                    }
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls"
                ]
            },
            "tag": "proxy-hy2"
        },
        {
            "listen": "127.0.0.1",
            "port": 10085,
            "protocol": "dokodemo-door",
            "settings": {
                "address": "127.0.0.1"
            },
            "tag": "api"
        }
    ],
    "outbounds": [
        {
            "protocol": "freedom",
            "settings": {
                "domainStrategy": "UseIPv4v6"
            }
        },
        {
            "protocol": "blackhole",
            "settings": {},
            "tag": "block"
        }
    ],
    "routing": {
        "rules": [
            {
                "type": "field",
                "outboundTag": "block",
                "domain": [
                    "geosite:falungong",
                    "geosite:category-bank-cn",
                    "geosite:ookla-speedtest",
                    "geosite:category-public-tracker",
                    "domain:cachefly.cachefly.net",
                    "domain:speed.cloudflare.com"
                ]
            },
            {
                "type": "field",
                "outboundTag": "block",
                "protocol": [
                    "bittorrent"
                ]
            },
            {
                "type": "field",
                "inboundTag": [
                    "api"
                ],
                "outboundTag": "api"
            },
            {
                "type": "field",
                "port": "25, 465, 587",
                "outboundTag": "block"
            }
        ],
        "strategy": "rules"
    },
    "policy": {
        "levels": {
            "0": {
                "statsUserUplink": true,
                "statsUserDownlink": true,
                "statsUserOnline": true
            }
        },
        "system": {
            "statsInboundUplink": true,
            "statsInboundDownlink": true
        }
    },
    "stats": {},
    "api": {
        "tag": "api",
        "services": [
            "HandlerService",
            "LoggerService",
            "StatsService"
        ]
    },
    "ssrpanel": {
        "nodeId": 123,
        "checkRate": 600,
        "ipLimit": 3,
        "ignoreEmptyVmessID": true,
        "user": {
            "inboundTag": "proxy",
            "inboundTags": [
                "__inboundTags__"
            ],
            "level": 0,
            "alterId": 0,
            "flow": "",
            "flows": {
                "__vlessVisionTag__": "__v2Flow__"
            },
            "security": "none"
        },
        "mysql": {
            "host": "__dbHost__",
            "port": 3306,
            "user": "__dbUser__",
            "password": "__dbPassword__",
            "dbname": "__dbName__"
        }
    }
}