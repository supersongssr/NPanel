#!/bin/sh
####
# NPanel 项目菜单入口 (./run)
#
# 用法:
#   ./run                       # 交互菜单
#   ./run migrate               # 非交互: 应用数据库迁移 (供 prod.deploy 远程触发)
#   ./run migrate-status        # 非交互: 查看迁移状态
#   ./run migrate-pending       # 非交互: 检测待执行迁移 (退出码 0=有 1=无 2=失败)
#   ./run cache-clear           # 非交互: 清理应用缓存
#   ./run route-cache           # 非交互: 重置并重建路由缓存 (route:clear + route:cache)
#
# 远程触发示例 (prod.deploy 同步完代码后, 统一在 php7-npanel-admin 容器内执行):
#   ssh "$HOST" "podman exec -w $PATH php7-npanel-admin sh ./run migrate"
####

# PHP CLI 路径: 优先用 PATH 里的 php (宝塔/crontab 已配好);
# 否则可经环境变量覆盖: PHP_BIN=/www/server/php/74/bin/php ./run migrate
PHP_BIN="${PHP_BIN:-php}"

# 退出码
EXIT_OK=0
EXIT_FAIL=1

# ----------------------------------------------------------------------
# 各功能函数
# ----------------------------------------------------------------------

# 应用数据库迁移 (幂等, 旧环境首次会把历史迁移全部 no-op 补跑)
migrate_db() {
    echo "📦 应用数据库迁移 (php artisan migrate --force)..."
    if "$PHP_BIN" artisan migrate --force; then
        echo "✅ 数据库迁移完成"
        return $EXIT_OK
    else
        echo "🔴⛔ 数据库迁移失败, 请手动检查: $PHP_BIN artisan migrate:status"
        return $EXIT_FAIL
    fi
}

# 查看迁移状态
migrate_status() {
    echo "📋 数据库迁移状态:"
    "$PHP_BIN" artisan migrate:status
}

# 检测是否有待执行迁移 (供 prod.deploy 自动迁移判断)
# 解析 migrate:status 表格中 Ran? 列为 N/No 的行 (兼容 Laravel 5.x/6+ 输出)
# 退出码: 0=有待执行迁移, 1=无待执行迁移, 2=检测失败
check_migrate_pending() {
    echo "🔍 检查待执行迁移 (php artisan migrate:status)..."
    STATUS_OUT=$("$PHP_BIN" artisan migrate:status 2>&1)
    if [ $? -ne 0 ]; then
        printf '%s\n' "$STATUS_OUT"
        echo "🔴 无法获取迁移状态"
        return 2
    fi
    # Laravel migrate:status 在迁移仓库(migrations 表)不存在/无迁移文件时仅输出
    # "No migrations found" 且退出码仍为 0 —— 此时实为全部迁移待执行, 不能判为
    # "无待执行", 否则自动迁移与手动迁移提醒双双跳过. 归入检测失败(2), 让
    # prod.deploy 走 unknown 分支给出人工迁移提示.
    case "$STATUS_OUT" in
        *"No migrations found"*)
            printf '%s\n' "$STATUS_OUT"
            echo "🔴 迁移仓库不存在或无迁移文件, 无法判定待执行状态 (请手动 migrate:status 确认)"
            return 2
            ;;
    esac
    PENDING=$(printf '%s\n' "$STATUS_OUT" | grep -cE '^[[:space:]]*\|[[:space:]]*No?[[:space:]]*\|')
    if [ "$PENDING" -gt 0 ]; then
        echo "🟡 发现 $PENDING 个待执行迁移"
        return 0
    fi
    echo "✅ 无待执行迁移"
    return 1
}

# 回滚最近一次迁移 (危险操作, 仅交互菜单可见, 不暴露给远程非交互调用)
migrate_rollback() {
    echo "⏪ 回滚最近一次迁移 (php artisan migrate:rollback --force)..."
    "$PHP_BIN" artisan migrate:rollback --force
}

# 清理应用缓存 (config/route/view/cache)
cache_clear() {
    echo "🧹 清理应用缓存..."
    "$PHP_BIN" artisan optimize:clear
}

# 重置并重建路由缓存 (供 prod.deploy 同步代码后远程触发)
# 先 route:clear 清掉残留旧缓存, 再 route:cache 重建, 避免新路由不生效
route_cache() {
    echo "🧹 重置路由缓存 (php artisan route:clear)..."
    CLEAR_RC=0
    "$PHP_BIN" artisan route:clear || CLEAR_RC=$?
    if [ "$CLEAR_RC" -ne 0 ]; then
        echo "🟡 route:clear 失败, 旧路由缓存可能仍残留 (请检查 artisan 可运行性 / bootstrap/cache 权限)"
    fi
    echo "📦 重建路由缓存 (php artisan route:cache)..."
    if "$PHP_BIN" artisan route:cache; then
        echo "✅ 路由缓存已重建"
        return $EXIT_OK
    else
        echo "🔴⛔ 路由缓存重建失败"
        if [ "$CLEAR_RC" -eq 0 ]; then
            echo "   (旧缓存已清除, 路由将从文件加载)"
        else
            echo "   (旧缓存清除亦失败, 可能残留旧路由缓存导致新路由不生效!)"
        fi
        echo "   请检查是否存在闭包路由, 稍后手动重试: $PHP_BIN artisan route:cache"
        return $EXIT_FAIL
    fi
}

# 重启队列 worker (若用 queue.sh 托管)
queue_restart() {
    if [ -x ./queue.sh ]; then
        echo "🔄 重启队列 worker..."
        ./queue.sh
    else
        echo "⚠️  未找到 ./queue.sh, 跳过"
    fi
}

# ----------------------------------------------------------------------
# 非交互模式: ./run <command>
# ----------------------------------------------------------------------
run_direct() {
    cmd="$1"
    case "$cmd" in
        migrate|migrate:up)
            migrate_db
            return $?
            ;;
        migrate-status|status)
            migrate_status
            return $?
            ;;
        migrate-pending|pending)
            check_migrate_pending
            return $?
            ;;
        migrate-rollback|rollback)
            migrate_rollback
            return $?
            ;;
        cache-clear|cache:clear|clear)
            cache_clear
            return $?
            ;;
        route-cache|route:cache)
            route_cache
            return $?
            ;;
        queue-restart|queue)
            queue_restart
            return $?
            ;;
        *)
            echo "🔴 未知命令: $cmd"
            echo "可用命令: migrate | migrate-status | migrate-pending | migrate-rollback | cache-clear | route-cache | queue-restart"
            return $EXIT_FAIL
            ;;
    esac
}

# ----------------------------------------------------------------------
# 交互菜单
# ----------------------------------------------------------------------
show_menu() {
    cat <<'EOF'

==========================================
  NPanel 管理菜单
==========================================
  1) 应用数据库迁移          (migrate)
  2) 查看迁移状态            (migrate:status)
  3) 回滚最近一次迁移        (migrate:rollback)  [危险]
  4) 清理应用缓存            (optimize:clear)
  5) 重启队列 worker         (queue.sh)
  0) 退出
==========================================
EOF
}

menu_loop() {
    while true; do
        show_menu
        printf "请选择 [0-5]: "
        read -r choice
        case "$choice" in
            1) migrate_db ;;
            2) migrate_status ;;
            3) migrate_rollback ;;
            4) cache_clear ;;
            5) queue_restart ;;
            0|q|Q)
                echo "👋 再见"
                break
                ;;
            *)
                echo "🔴 无效选择: $choice"
                ;;
        esac
        echo ""
        printf "按回车继续..."
        read -r dummy
    done
}

# ----------------------------------------------------------------------
# 入口
# ----------------------------------------------------------------------
if [ $# -gt 0 ]; then
    # 非交互模式
    run_direct "$@"
    exit $?
else
    menu_loop
fi
